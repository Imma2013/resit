# Public base URL used for OAuth redirects (for example https://resit.vercel.app).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Firebase client configuration. These values identify the Firebase app and are
# safe to expose to the browser. Firebase Admin credentials are server-only.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Convex deployment URL, generated by `pnpm convex:dev` or `pnpm convex:deploy`.
NEXT_PUBLIC_CONVEX_URL=
FIREBASE_PROJECT_ID=

# Server-side AI provider credentials. Never prefix these with NEXT_PUBLIC_.
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-3-flash-preview
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
GEMINI_VIDEO_MODEL=veo-3.1
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global

# OAuth application credentials. Users connect their own social accounts in-app.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
META_APP_ID=
META_APP_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Used to encrypt provider refresh tokens at rest.
RESIT_TOKEN_ENCRYPTION_KEY=

